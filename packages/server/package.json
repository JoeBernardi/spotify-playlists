{
  "name": "@spotify-playlists/server",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.3.1",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.7",
    "@spotify-playlists/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^24.6.0",
    "typescript": "~5.9.3"
  }
}
